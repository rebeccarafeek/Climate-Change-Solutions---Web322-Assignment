

<!doctype html>

<html lang="en-CA" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <title>Climate Solutions</title>
    <link href="/css/main.css" rel="stylesheet">
  </head>
  <body>
    <%- include('./partials/navbar', {page: "", sector: ""}) %>

    <div class="container mx-auto px-4 py-8">
      <% if (project) { %>
        <div class="hero bg-base-200 min-h-[40vh] mb-8">
          <div class="hero-content text-center">
            <div class="max-w-md">
              <h1 class="text-5xl font-bold"><%= project.title %></h1>
              <p class="py-6">Detailed information about the project: <%= project.title %></p>
            </div>
          </div>
        </div>

        <!-- project details -->
        <div class="bg-white shadow-md rounded-lg overflow-hidden mb-8">
          <% if (project.feature_img_url) { %>
            <img src="<%= project.feature_img_url %>" alt="<%= project.title %>" class="w-full h-64 object-cover">
          <% } %>
          
          <div class="p-6">
            <h2 class="text-2xl font-bold mb-3">Introduction</h2>
            <p class="mb-6"><%= project.intro_short %></p>
            <h2 class="text-2xl font-bold mb-3">Impact</h2>
            <p class="mb-6"><%= project.impact %></p>
            
            <!-- quote -->
            <div id="quote-container" class="bg-base-200 p-4 rounded-lg mb-6">
              <div id="quote">Loading quote...</div>
              <div id="author" class="text-right font-semibold mt-2">-</div>
            </div>
            
            <!-- external links -->
            <div class="mt-8 flex flex-wrap gap-3">
              <% if (project.original_source_url) { %>
                <a href="<%= project.original_source_url %>" target="_blank" class="btn btn-primary">
                  Learn More
                </a>
              <% } %>
              <a href="/solutions/editProject/<%= project.id %>" class="btn btn-primary">
                Edit Project
              </a>
              <a href="#" onclick="history.back(); return false;" class="btn btn-outline">
                Return to Projects
              </a>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="text-center py-8">
          <h1 class="text-4xl font-bold">Project Not Found</h1>
          <p class="py-6">Sorry this project doesn't exist.</p>
          <a href="/solutions/projects" class="btn btn-primary">Back to Projects</a>
        </div>
      <% } %>
    </div>

    <!-- getting quote from -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // gets the quote at random
        fetch("https://dummyjson.com/quotes/random")
          .then(response => {
            if (!response.ok) {
              throw new Error('Network failed');
            }
            return response.json();
          })
          .then(data => {
            // updates the DOM with the quote and author
            document.getElementById("quote").textContent = `"${data.quote}"`;
            document.getElementById("author").textContent = `- ${data.author}`;
          })
          .catch(error => {
            console.error('Error fetching quote:', error);
            document.getElementById("quote").textContent = "Could not load quote";
          });
      });
    </script>
  </body>
</html>